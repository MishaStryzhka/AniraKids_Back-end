{
  "name": "anira-kids_back-end",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "cross-env NODE_ENV=production node ./server.js",
    "dev": "cross-env NODE_ENV=development nodemon ./server.js",
    "typecheck": "tsc -p tsconfig.v2.json --noEmit",
    "build:v2": "tsc -p tsconfig.v2.json",
    "check:v2-models": "node scripts/check-v2-models.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "vercel-build": "npm run typecheck && npm run build:v2 && npm run check:v2-models && npm run check:v2-utils && npm run check:v2-availability && npm run check:v2-reservation-service && npm run check:v2-reservation-api && npm run check:v2-reservation-hardening && npm run check:v2-admin-api && npm run check:v2-product-media",
    "check:v2-utils": "node scripts/check-v2-utils.js",
    "check:v2-availability": "node scripts/check-v2-availability.js",
    "check:v2-availability:integration": "npm run build:v2 && node scripts/check-v2-availability-integration.js",
    "check:v2-concurrency:integration": "npm run build:v2 && node scripts/check-v2-concurrency-integration.js",
    "check:v2-reservation-service": "node scripts/check-v2-reservation-service.js",
    "check:v2-reservation-service:integration": "npm run build:v2 && node scripts/check-v2-reservation-service-integration.js",
    "check:v2-reservation-api": "node scripts/check-v2-reservation-api.js",
    "check:v2-reservation-api:integration": "npm run build:v2 && node scripts/check-v2-reservation-api-integration.js",
    "check:v2-reservation-hardening": "node scripts/check-v2-reservation-hardening.js",
    "check:v2-reservation-hardening:integration": "npm run build:v2 && node scripts/check-v2-reservation-hardening-integration.js",
    "check:v2-production-indexes": "npm run build:v2 && node scripts/check-v2-production-indexes.js",
    "check:v2-admin-api": "node scripts/check-v2-admin-api.js",
    "check:v2-admin-api:integration": "npm run build:v2 && node scripts/check-v2-admin-api-integration.js",
    "check:v2-product-media": "node scripts/check-v2-product-media.js",
    "check:v2-product-media:integration": "npm run build:v2 && node scripts/check-v2-product-media-integration.js",
    "check:v2-product-media:cloudinary": "npm run build:v2 && node scripts/check-v2-product-media-cloudinary.js"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.0",
    "axios": "^1.6.7",
    "bcrypt": "^5.1.0",
    "cloudinary": "^1.39.0",
    "cors": "2.8.5",
    "cross-env": "7.0.3",
    "date-fns": "^3.3.1",
    "dotenv": "^16.3.1",
    "express": "4.17.1",
    "express-session": "^1.17.3",
    "geoip-lite": "^1.4.10",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.0",
    "jwt-decode": "^4.0.0",
    "moment": "^2.29.4",
    "mongoose": "^6.9.2",
    "morgan": "1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nanoid": "^3.3.4",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.8",
    "passport": "^0.5.3",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth2": "^0.2.0",
    "sharp": "^0.33.2",
    "socket.io": "^4.7.2",
    "swagger-ui-express": "^5.0.0",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "ejs": "^3.1.9",
    "eslint": "7.19.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-config-standard": "16.0.3",
    "eslint-plugin-import": "2.25.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "5.2.0",
    "nodemon": "2.0.15",
    "typescript": "5.8.3"
  }
}
